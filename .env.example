# 映画データソース: TMDB。pnpm movies:sync で movies テーブルに取り込む
# （リクエスト時には TMDB を叩かず、DB に入ったものだけを読む）
# TMDB API Read Access Token (v4): https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=

# データベース（Drizzle ORM / node-postgres）
# - ローカル開発: pnpm db:up で起動する Docker の PostgreSQL
DATABASE_URL=postgresql://cinematchan:cinematchan@localhost:5432/cinematchan
# - デプロイ先: Neon などホスティングの接続文字列
# DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
#
# pnpm dev:pglite は DATABASE_URL を PGlite サーバー（.pglite に永続化）で上書きする。
# DATABASE_URL 未設定の pnpm dev はプロセス内 PGlite（PGLITE_DATA_DIR、既定はメモリ）を使う。
# PGLITE_DATA_DIR=.pglite

# Vercel Cron (/api/cron/movies) の認証トークン。Vercel が Bearer で送ってくる
# 本番では必須（未設定だとエンドポイントは一律 401 を返す）
# CRON_SECRET=

# 開発時の起動時シード（ダミー映画・デモイベント /e/demo）を止め、代わりに TMDB の実データを取り込む
# SEED=false
