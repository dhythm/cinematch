{
  "name": "cinematch",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "db:pglite": "node --no-warnings=ExperimentalWarning scripts/pglite.mts",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm test",
    "browser": "agent-browser"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@electric-sql/pglite": "^0.5.8",
    "@tanstack/react-query": "^5.104.0",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "agent-browser": "^0.38.1",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vitest": "^5.0.2"
  }
}
